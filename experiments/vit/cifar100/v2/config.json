{
  "experiment": "cifar100_vit_v2_generalization",
  "architecture": {
    "family": "torchvision VisionTransformer (ViT-Tiny/4)",
    "constructor": "torchvision.models.vision_transformer.VisionTransformer",
    "input_resolution": 32,
    "patch_size": 4,
    "image_patches": 64,
    "tokens_including_cls": 65,
    "hidden_dim": 192,
    "depth": 12,
    "heads": 3,
    "mlp_dim": 768,
    "dropout": 0.0,
    "attention_dropout": 0.0,
    "feature_dim": 192,
    "upstream_classes": 80,
    "initialization": "random torchvision VisionTransformer constructor; direct class construction; no weights/pretrained argument or checkpoint load"
  },
  "seeds": [0, 1],
  "models": ["M1", "M2", "M3", "M4"],
  "epochs": 300,
  "batch_size": 256,
  "feature_batch_size": 512,
  "num_workers": 4,
  "optimizer": "AdamW",
  "learning_rate": 0.0003,
  "weight_decay": 0.05,
  "scheduler": "5-epoch linear warmup followed by cosine decay to zero",
  "warmup_epochs": 5,
  "loss": "cross entropy over soft Mixup/CutMix targets",
  "label_smoothing": 0.1,
  "augmentation": {
    "random_crop": {"size": 32, "padding": 4},
    "random_horizontal_flip_probability": 0.5,
    "randaugment": {"implementation": "torchvision.transforms.v2.RandAugment", "num_ops": 2, "magnitude": 9, "num_magnitude_bins": 31, "interpolation": "NEAREST", "fill": null},
    "random_erasing": {"probability": 0.25, "scale": [0.02, 0.33], "ratio": [0.3, 3.3], "value": 0.0},
    "mixup": {"alpha": 0.8},
    "cutmix": {"alpha": 1.0},
    "batch_mixing_probability": 1.0,
    "mixup_cutmix_switch_probability": 0.5,
    "mixing_mode": "batch",
    "drop_path_rate": 0.1,
    "drop_path_schedule": "linear from 0.0 at block 1 to 0.1 at block 12"
  },
  "normalization_mean": [0.5071, 0.4867, 0.4408],
  "normalization_std": [0.2675, 0.2565, 0.2761],
  "amp_on_cuda": true,
  "deterministic": true,
  "clean_final_train_accuracy": true,
  "classification_gate": {"adequate_minimum": 0.70, "mixed_minimum": 0.65, "insufficient_below": 0.65},
  "knn_k": 50,
  "knn_distance": "cosine over L2-normalized frozen CLS features",
  "bootstrap_draws": 10000,
  "bootstrap_seed": 20260908,
  "delta_definition": "AUROC_withheld - mean(AUROC across three supervised/present rotations), within seed, then arithmetic mean over seeds",
  "probe_recipe": {"architecture": "Linear(192,20,bias=True)", "epochs": 50, "batch_size": 256, "optimizer": "SGD", "learning_rate": 0.1, "momentum": 0.9, "scheduler": "CosineAnnealingLR(T_max=50)", "loss": "CrossEntropyLoss", "device": "cpu"},
  "detectors": ["knn", "energy", "msp", "mahalanobis", "vim", "neco", "nci", "gradorth", "odin"],
  "odin": {"temperature": 1000.0, "epsilon_raw_pixel_units": 0.002, "batch_size": 512, "precision": "FP32", "clipping": false},
  "nci": {"alpha": 0.01, "selection": "fixed before evaluation; no revisit or sweep"},
  "resume": true
}
