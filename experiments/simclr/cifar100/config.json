{
  "architecture": "CIFAR ResNet-18",
  "pretrained": false,
  "feature_dim": 512,
  "projection_hidden_dim": 512,
  "projection_dim": 128,
  "epochs": 200,
  "batch_size": 256,
  "optimizer": "SGD",
  "learning_rate": 0.5,
  "momentum": 0.9,
  "weight_decay": 0.0001,
  "schedule": "cosine",
  "temperature": 0.5,
  "seeds": [0, 1],
  "models": ["M1", "M2", "M3", "M4"],
  "augmentation": {
    "random_resized_crop": {"size": 32, "scale": [0.2, 1.0]},
    "horizontal_flip_probability": 0.5,
    "color_jitter": [0.4, 0.4, 0.4, 0.1],
    "color_jitter_probability": 0.8,
    "grayscale_probability": 0.2
  },
  "probe": {"epochs": 50, "batch_size": 512, "optimizer": "SGD", "learning_rate": 0.1, "momentum": 0.9, "weight_decay": 0.0, "schedule": "cosine"}
}
